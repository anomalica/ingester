#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STAGING_DIR="${SCRIPT_DIR}/staging"
INGESTS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)/ingests"

usage() {
	echo "Usage: ingest [--force] [--canary] [--source-url URL [--source-id ID]] [--record-metadata-file PATH] [--posted-by NAME --posted-date DATE] [--run-uuid UUID --result-path PATH] <url-or-path>" >&2
	echo "" >&2
	echo "Acquire a URL or local file and route to the appropriate format handler." >&2
	echo "" >&2
	echo "Options:" >&2
	echo "  --force        Re-process even if output already exists" >&2
	echo "  --canary       Validate one existing rerender against HEAD; never commit" >&2
	echo "  --source-url   Provenance for a LOCAL source: stamp this origin URL" >&2
	echo "                 (a local path carries none). Use when re-processing an" >&2
	echo "                 archived file, e.g. re-transcribing an .opus as record/2" >&2
	echo "  --source-id    Optional stable id for --source-url; derived from the URL" >&2
	echo "                 when omitted (youtube:{id} / url:{hash})" >&2
	echo "  --record-metadata-file  Validated generic record metadata snapshot" >&2
	echo "  --posted-by    Publisher/channel of the fetched copy" >&2
	echo "  --posted-date  Publication/upload date of the fetched copy" >&2
	echo "  --run-uuid     Scheduler-supplied canonical UUID for the result receipt" >&2
	echo "  --result-path  Absolute path for the atomic structured result receipt" >&2
	exit 1
}

FORCE=""
FORCE_FLAG=0
INPUT=""
COPYRIGHT_STATUS=""
NO_COMMIT=0
CANARY=0
USE_API=0
INGEST_MODEL="${INGEST_MODEL:-}"
SOURCE_URL=""
SOURCE_ID=""
RECORD_METADATA_FILE=""
POSTED_BY=""
POSTED_DATE=""
RUN_UUID=""
RESULT_PATH=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	--force)
		FORCE="--force"
		FORCE_FLAG=1
		shift
		;;
	--copyright)
		COPYRIGHT_STATUS="$2"
		shift 2
		;;
	--copyright=*)
		COPYRIGHT_STATUS="${1#*=}"
		shift
		;;
	--no-commit)
		NO_COMMIT=1
		shift
		;;
	--canary)
		CANARY=1
		NO_COMMIT=1
		shift
		;;
	--api)
		USE_API=1
		shift
		;;
	--model)
		INGEST_MODEL="$2"
		shift 2
		;;
	--model=*)
		INGEST_MODEL="${1#*=}"
		shift
		;;
	--source-url)
		SOURCE_URL="$2"
		shift 2
		;;
	--source-url=*)
		SOURCE_URL="${1#*=}"
		shift
		;;
	--source-id)
		SOURCE_ID="$2"
		shift 2
		;;
	--source-id=*)
		SOURCE_ID="${1#*=}"
		shift
		;;
	--record-metadata-file)
		RECORD_METADATA_FILE="$2"
		shift 2
		;;
	--record-metadata-file=*)
		RECORD_METADATA_FILE="${1#*=}"
		shift
		;;
	--posted-by)
		POSTED_BY="$2"
		shift 2
		;;
	--posted-by=*)
		POSTED_BY="${1#*=}"
		shift
		;;
	--posted-date)
		POSTED_DATE="$2"
		shift 2
		;;
	--posted-date=*)
		POSTED_DATE="${1#*=}"
		shift
		;;
	--run-uuid)
		RUN_UUID="$2"
		shift 2
		;;
	--run-uuid=*)
		RUN_UUID="${1#*=}"
		shift
		;;
	--result-path)
		RESULT_PATH="$2"
		shift 2
		;;
	--result-path=*)
		RESULT_PATH="${1#*=}"
		shift
		;;
	--help | -h) usage ;;
	-*)
		echo "Unknown option: $1" >&2
		usage
		;;
	*)
		if [[ -n "$INPUT" ]]; then
			echo "Error: multiple inputs not supported" >&2
			usage
		fi
		INPUT="$1"
		shift
		;;
	esac
done

if [[ -z "$INPUT" ]]; then
	usage
fi
if [[ "$CANARY" -eq 1 ]] && [[ "$FORCE_FLAG" -ne 1 ]]; then
	echo "Error: --canary requires --force" >&2
	exit 1
fi

if [[ ! -d "$INGESTS_DIR" ]]; then
	echo "Error: ingests not found at ${INGESTS_DIR}" >&2
	echo "Clone it with: gh repo clone anomalica/ingests $(dirname "${INGESTS_DIR}")" >&2
	exit 1
fi

SCHEDULER_RESULT=0
if { [[ -n "$RUN_UUID" ]] && [[ -z "$RESULT_PATH" ]]; } ||
	{ [[ -z "$RUN_UUID" ]] && [[ -n "$RESULT_PATH" ]]; }; then
	echo "Error: --run-uuid and --result-path must be supplied together" >&2
	exit 1
fi
if [[ -n "$RUN_UUID" ]]; then
	SCHEDULER_RESULT=1
fi
UUID="${RUN_UUID:-$(python3 -c 'import uuid; print(uuid.uuid4())')}"
if ! RUN_UUID="$UUID" python3 -c "import os, uuid; value=os.environ['RUN_UUID']; raise SystemExit(0 if str(uuid.UUID(value)) == value else 1)" 2>/dev/null; then
	echo "Error: --run-uuid must be a canonical lowercase UUID" >&2
	exit 1
fi
if [[ -z "$RESULT_PATH" ]]; then
	DATA_DIR="${ANOMALICA_DATA_DIR:-${HOME}/.local/share/anomalica}"
	RESULT_PATH="${DATA_DIR}/ingest-results/${UUID}.json"
elif [[ "$RESULT_PATH" != /* ]]; then
	echo "Error: --result-path must be an absolute path" >&2
	exit 1
fi

emit_result() {
	local outcome="$1"
	local record_path="$2"
	local commit_sha="${3:-}"
	if [[ -z "$commit_sha" ]]; then
		commit_sha="$(git -C "$INGESTS_DIR" rev-parse HEAD)"
	fi
	PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
		python3 "${SCRIPT_DIR}/shared/ingest_result.py" publish \
		--ingests-dir "$INGESTS_DIR" \
		--result-path "$RESULT_PATH" \
		--run-uuid "$UUID" \
		--outcome "$outcome" \
		--record-path "$record_path" \
		--commit-sha "$commit_sha"
}

INGESTS_LOCK_HELD=0
INGESTS_HEAD_BEFORE=""
acquire_ingests_write_lock() {
	if [[ "$INGESTS_LOCK_HELD" -eq 1 ]]; then
		return
	fi
	local common_dir
	common_dir="$(git -C "$INGESTS_DIR" rev-parse --git-common-dir)"
	if [[ "$common_dir" != /* ]]; then
		common_dir="$(realpath "${INGESTS_DIR}/${common_dir}")"
	fi
	exec {INGESTS_LOCK_FD}>"${common_dir}/anomalica-write.lock"
	flock -x "$INGESTS_LOCK_FD"
	INGESTS_LOCK_HELD=1
	INGESTS_HEAD_BEFORE="$(git -C "$INGESTS_DIR" rev-parse HEAD)"
}

release_ingests_write_lock() {
	if [[ "$INGESTS_LOCK_HELD" -eq 0 ]]; then
		return
	fi
	flock -u "$INGESTS_LOCK_FD"
	exec {INGESTS_LOCK_FD}>&-
	INGESTS_LOCK_HELD=0
	INGESTS_HEAD_BEFORE=""
}

# Capture the ingester version (git short hash) and write it to .env so the
# format containers (which don't have .git/) can read it via the auto-loaded
# .env file. This makes the version field of each record reproducible.
INGESTER_VERSION="$(cd "$SCRIPT_DIR" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
ENV_FILE="${SCRIPT_DIR}/.env"
touch "$ENV_FILE"
if grep -q "^INGESTER_VERSION=" "$ENV_FILE"; then
	sed -i "s|^INGESTER_VERSION=.*|INGESTER_VERSION=${INGESTER_VERSION}|" "$ENV_FILE"
else
	echo "INGESTER_VERSION=${INGESTER_VERSION}" >>"$ENV_FILE"
fi

# Provider selection for the PDF handler: metered Anthropic API only when
# --api is passed; otherwise the flat-rate Claude Code session. Written to
# .env (auto-loaded by the format containers) every run so it always
# reflects this invocation rather than a stale value.
if grep -q "^INGEST_USE_API=" "$ENV_FILE"; then
	sed -i "s|^INGEST_USE_API=.*|INGEST_USE_API=${USE_API}|" "$ENV_FILE"
else
	echo "INGEST_USE_API=${USE_API}" >>"$ENV_FILE"
fi

# PDF handler model override: a bare provider/model id (e.g. openai/gpt-5.6-luna)
# routes to the metered OpenRouter vision provider. Written every run so it
# reflects this invocation, not a stale value.
if grep -q "^INGEST_MODEL=" "$ENV_FILE"; then
	sed -i "s|^INGEST_MODEL=.*|INGEST_MODEL=${INGEST_MODEL}|" "$ENV_FILE"
else
	echo "INGEST_MODEL=${INGEST_MODEL}" >>"$ENV_FILE"
fi

is_url() {
	[[ "$1" =~ ^https?:// ]]
}

record3_asset_is_current() {
	RECORD_PATH="$1" ASSET_HASH_VALUE="$2" python3 -c "
import os, pathlib, sys, yaml
record = pathlib.Path(os.environ['RECORD_PATH'])
versions_path = record.parent / '_pipeline_versions.yaml'
if not record.is_file() or not versions_path.is_file():
    raise SystemExit(1)
frontmatter = yaml.safe_load(record.read_text().split('---', 2)[1]) or {}
if frontmatter.get('schema') != 'anomalica/record/3':
    raise SystemExit(1)
labelled = 'sha256:' + os.environ['ASSET_HASH_VALUE']
asset = next((item for item in frontmatter.get('assets', []) if isinstance(item, dict) and item.get('asset_hash') == labelled), None)
if not isinstance(asset, dict):
    raise SystemExit(1)
source_type = asset.get('source_type')
processing = frontmatter.get('processing') or {}
if not isinstance(processing, dict):
    raise SystemExit(1)
recorded = next((item.get('pipeline_version') for item in processing.get('asset_pipeline_versions', []) if isinstance(item, dict) and item.get('asset_hash') == labelled and item.get('source_type') == source_type), None)
current = (yaml.safe_load(versions_path.read_text()) or {}).get(source_type)
raise SystemExit(0 if type(recorded) is int and recorded > 0 and recorded == current else 1)
"
}

# For local files, pre-hash and check if already in the ingests repo
if ! is_url "$INPUT"; then
	if [[ ! -f "$INPUT" ]]; then
		echo "Error: file not found: ${INPUT}" >&2
		exit 1
	fi
	FILE_HASH="$(sha256sum "$INPUT" | cut -d' ' -f1)"
	EXISTING="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_hash
match = find_by_source_hash(Path('${INGESTS_DIR}/store'), '${FILE_HASH}')
print(match if match else '')
	")"
	if [[ -n "$EXISTING" ]] && [[ "$FORCE_FLAG" -eq 0 ]]; then
		acquire_ingests_write_lock
		EXISTING="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_hash
match = find_by_source_hash(Path('${INGESTS_DIR}/store'), '${FILE_HASH}')
print(match if match else '')
		")"
		if [[ -z "$EXISTING" ]]; then
			release_ingests_write_lock
		else
			echo "Skipping: already ingested (hash: ${FILE_HASH:0:12}...)" >&2
			emit_result "no-op" "$EXISTING"
			exit 0
		fi
	fi
fi

RUN_DIR="${STAGING_DIR}/${UUID}"
mkdir -p "$RUN_DIR"

echo "Run: ${UUID}" >&2

if is_url "$INPUT"; then
	echo "Acquiring: ${INPUT}" >&2
	(cd "${SCRIPT_DIR}/acquire" && cm run acquire "$INPUT" -- --staging-dir "/mnt/staging/${UUID}")
else
	RESOLVED="$(realpath "$INPUT")"
	EXT="${RESOLVED##*.}"
	cp "$RESOLVED" "${RUN_DIR}/asset.${EXT}"

	DETECTED_TYPE="$(SCRIPT_DIR="${SCRIPT_DIR}" ASSET_FILE="${RUN_DIR}/asset.${EXT}" python3 -c "
import os, sys
sys.path.insert(0, os.path.join(os.environ['SCRIPT_DIR'], 'acquire/workspace'))
from detect import detect_from_bytes, detect_from_extension
asset_file = os.environ['ASSET_FILE']
with open(asset_file, 'rb') as f:
    data = f.read(8192)
result = detect_from_bytes(data)
if not result:
    result = detect_from_extension(asset_file)
print(result or 'application/octet-stream')
")"

	SOURCE_PATH="${RESOLVED}" ASSET_NAME="asset.${EXT}" DETECTED_TYPE="${DETECTED_TYPE}" \
		MANIFEST_OUT="${RUN_DIR}/manifest.json" COPYRIGHT_STATUS="${COPYRIGHT_STATUS}" \
		SOURCE_URL="${SOURCE_URL}" SOURCE_ID="${SOURCE_ID}" POSTED_BY="${POSTED_BY}" \
		POSTED_DATE="${POSTED_DATE}" SCRIPT_DIR="${SCRIPT_DIR}" python3 -c "
import hashlib, json, os, re, subprocess, sys
from datetime import datetime, timezone
sys.path.insert(0, os.path.join(os.environ['SCRIPT_DIR'], 'acquire/workspace'))
from manifest_meta import video_metadata_fields
manifest = {
    'source': os.environ['SOURCE_PATH'],
    'asset': os.environ['ASSET_NAME'],
    'detected_type': os.environ['DETECTED_TYPE'],
    'fetch_method': 'local',
    'fetched_at': datetime.now(timezone.utc).isoformat(),
}
copyright_status = os.environ.get('COPYRIGHT_STATUS', '')
if copyright_status:
    manifest['copyright_status'] = copyright_status
# Known provenance for re-processing an archived local source (e.g. re-transcribing
# an archived .opus as record/2): a local path carries no origin, so stamp the
# supplied source URL and a stable source_id (derived to match the URL path's
# convention when not given explicitly).
source_url = os.environ.get('SOURCE_URL', '')
source_id = os.environ.get('SOURCE_ID', '')
if source_url:
    manifest['source_url'] = source_url
    # A video-platform URL IS a video, even when what we hand the handler is the
    # audio-only file. acquire.py already applies this rule on the URL path; a
    # LOCAL file with --source-url skipped it, so the type fell back to the
    # artefact's MIME and a YouTube video was recorded as an audio source - how
    # it was acquired, not what it is. archived_ext already describes the
    # artefact, so naming the source medium here loses nothing.
    video_platform = bool(re.search(r'(?:youtube\.com|youtu\.be|vimeo\.com|twitch\.tv)/', source_url))
    if video_platform:
        manifest['original_type'] = 'video'
    if not source_id:
        m = re.search(r'(?:youtube\.com/watch\?v=|youtu\.be/|youtube\.com/embed/|youtube\.com/shorts/)([A-Za-z0-9_-]{11})', source_url)
        source_id = f'youtube:{m.group(1)}' if m else 'url:' + hashlib.sha256(source_url.encode('utf-8')).hexdigest()[:12]
    # Re-fetch the source's real metadata so a re-processed local archive keeps its
    # title/publisher/date instead of falling back to the raw URL (which is what the
    # record showed until this landed). yt-dlp --dump-json is METADATA ONLY - no
    # download - so it's cheap and doesn't trigger the download bot-check. The field
    # mapping (video_metadata_fields) is SHARED with acquire's URL path, so a
    # reprocess record is indistinguishable from a fresh URL ingest. Best effort: a
    # fetch failure leaves the URL-only manifest rather than aborting re-transcription.
    # Video platforms only: on a news article's URL yt-dlp has nothing to say and
    # takes the full timeout to say it, which turned a web refresh into a
    # minute-and-a-half wait per record.
    if video_platform:
        try:
            proc = subprocess.run(['yt-dlp', '--dump-json', '--no-warnings', source_url],
                                  capture_output=True, text=True, timeout=90)
            if proc.returncode == 0 and proc.stdout.strip():
                fields = video_metadata_fields(json.loads(proc.stdout))
                fields.pop('source_id', None)  # keep the explicit/URL-derived id below
                manifest.update(fields)
        except (subprocess.SubprocessError, OSError, ValueError):
            pass
if source_id:
    manifest['source_id'] = source_id
posted_by = os.environ.get('POSTED_BY', '')
posted_date = os.environ.get('POSTED_DATE', '')
if posted_by:
    manifest['posted_by'] = posted_by
if posted_date:
    manifest['posted_date'] = posted_date
with open(os.environ['MANIFEST_OUT'], 'w') as f:
    json.dump(manifest, f, indent=2)
"
	echo "Local file staged: ${DETECTED_TYPE}" >&2
fi

MANIFEST="${RUN_DIR}/manifest.json"
if [[ ! -f "$MANIFEST" ]]; then
	echo "Error: no manifest found after acquisition" >&2
	exit 1
fi

if [[ -n "$RECORD_METADATA_FILE" ]]; then
	PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
		python3 "${SCRIPT_DIR}/shared/record_metadata.py" manifest \
		--manifest "$MANIFEST" --metadata-file "$RECORD_METADATA_FILE"
fi

DETECTED_TYPE="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('detected_type') or '')")"
ASSET="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('asset') or '')")"
SOURCE_ID="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('source_id') or '')")"

if [[ -z "$DETECTED_TYPE" || -z "$ASSET" ]]; then
	ERROR="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('error', 'unknown error'))")"
	echo "Error: acquisition failed - ${ERROR}" >&2
	exit 1
fi

ASSET_PATH="${RUN_DIR}/${ASSET}"
if [[ ! -f "$ASSET_PATH" ]]; then
	echo "Error: no asset at ${ASSET_PATH}" >&2
	exit 1
fi
ASSET_HASH="$(sha256sum "$ASSET_PATH" | cut -d' ' -f1)"
EXISTING_ASSET="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_hash
match = find_by_source_hash(Path('${INGESTS_DIR}/store'), '${ASSET_HASH}')
print(match if match else '')
")"
if [[ -n "$EXISTING_ASSET" ]] && [[ "$FORCE_FLAG" -eq 0 ]]; then
	acquire_ingests_write_lock
	EXISTING_ASSET="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_hash
match = find_by_source_hash(Path('${INGESTS_DIR}/store'), '${ASSET_HASH}')
print(match if match else '')
	")"
	if [[ -z "$EXISTING_ASSET" ]]; then
		release_ingests_write_lock
	else
		echo "Skipping: acquired Asset already has its default whole-Asset Record" >&2
		emit_result "no-op" "$EXISTING_ASSET"
		exit 0
	fi
fi
if [[ -n "$EXISTING_ASSET" ]] && [[ "$FORCE_FLAG" -eq 1 ]]; then
	EXISTING_SCHEMA="$(python3 -c "import pathlib,yaml; p=pathlib.Path('${EXISTING_ASSET}'); print((yaml.safe_load(p.read_text().split('---',2)[1]) or {}).get('schema',''))")"
	if [[ "$EXISTING_SCHEMA" != "anomalica/record/3" ]]; then
		echo "Error: --force cannot refresh a legacy ${EXISTING_SCHEMA} envelope in place." >&2
		echo "Migrate it deterministically from held bytes with scripts/migrate-record3.py first; no provider was called." >&2
		exit 1
	fi
	# A scheduler retry after commit can lose only its result receipt. Record/3
	# keeps Selection identity across extraction revisions, so recognise completion
	# from the matching Asset's committed pipeline generation rather than a legacy
	# filename variant. An ordinary operator --force remains an unconditional run.
	if [[ "$SCHEDULER_RESULT" -eq 1 ]] && [[ "$CANARY" -eq 0 ]] && record3_asset_is_current "$EXISTING_ASSET" "$ASSET_HASH"; then
		acquire_ingests_write_lock
		EXISTING_ASSET="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_hash
match = find_by_source_hash(Path('${INGESTS_DIR}/store'), '${ASSET_HASH}')
print(match if match else '')
		")"
		if [[ -n "$EXISTING_ASSET" ]] && record3_asset_is_current "$EXISTING_ASSET" "$ASSET_HASH"; then
			echo "Skipping: scheduler reprocess generation already committed" >&2
			emit_result "no-op" "$EXISTING_ASSET"
			exit 0
		fi
		release_ingests_write_lock
	fi
fi

echo "Detected type: ${DETECTED_TYPE}" >&2

HANDLER=""
for format_yaml in "${SCRIPT_DIR}"/formats/*/format.yaml; do
	FORMAT_DIR="$(dirname "$format_yaml")"
	FORMAT_NAME="$(basename "$FORMAT_DIR")"

	if python3 -c "
import yaml, sys
with open('${format_yaml}') as f:
    fmt = yaml.safe_load(f)
sys.exit(0 if '${DETECTED_TYPE}' in fmt.get('handles', []) else 1)
"; then
		HANDLER="$FORMAT_NAME"
		break
	fi
done

if [[ -z "$HANDLER" ]]; then
	echo "Error: no format handler for type: ${DETECTED_TYPE}" >&2
	echo "Staging directory preserved: ${RUN_DIR}" >&2
	exit 1
fi

if [[ "$CANARY" -eq 1 ]]; then
	if [[ "$HANDLER" != "audio" ]]; then
		echo "Error: --canary currently supports existing audio/video rerenders only" >&2
		exit 1
	fi
	if is_url "$INPUT" || [[ -z "$EXISTING_ASSET" ]] || [[ "$EXISTING_SCHEMA" != "anomalica/record/3" ]]; then
		echo "Error: --canary requires a local source with an existing record/3" >&2
		exit 1
	fi
	CANARY_RECORD="${EXISTING_ASSET#${INGESTS_DIR}/}"
fi

echo "Routing to: ${HANDLER}" >&2

# Give the expensive handler a private snapshot. In particular, --force needs the
# old records, sidecars and aliases in order to construct the complete replacement,
# but must not mutate their live versions before the final compare-and-swap.
acquire_ingests_write_lock
RUN_OUTPUT="${RUN_DIR}/output"
INGESTS_BASE_HEAD="$INGESTS_HEAD_BEFORE"
release_ingests_write_lock
git -C "$INGESTS_DIR" worktree add --quiet --detach "$RUN_OUTPUT" "$INGESTS_BASE_HEAD"

HANDLER_LOG="${RUN_DIR}/handler.stderr"
case "$HANDLER" in
webpage)
	(cd "${SCRIPT_DIR}/formats/webpage" && cm run ingest output="$RUN_OUTPUT" "/mnt/staging/${UUID}" -- $FORCE) 2> >(tee "$HANDLER_LOG" >&2)
	;;
pdf)
	(cd "${SCRIPT_DIR}/formats/pdf" && cm run ingest output="$RUN_OUTPUT" -- --staging-dir "/mnt/staging/${UUID}" $FORCE) 2> >(tee "$HANDLER_LOG" >&2)
	;;
audio)
	AUDIO_CANARY_ARGS=()
	if [[ "$CANARY" -eq 1 ]]; then
		AUDIO_CANARY_ARGS=(--candidate-dir "/mnt/output/.ai/canary-candidates/${UUID}")
	fi
	(cd "${SCRIPT_DIR}/formats/audio" && cm run ingest output="$RUN_OUTPUT" "/mnt/staging/${UUID}" -- $FORCE "${AUDIO_CANARY_ARGS[@]}") 2> >(tee "$HANDLER_LOG" >&2)
	;;
ebook)
	(cd "${SCRIPT_DIR}/formats/ebook" && cm run ingest output="$RUN_OUTPUT" "/mnt/staging/${UUID}" -- $FORCE) 2> >(tee "$HANDLER_LOG" >&2)
	;;
*)
	echo "Error: handler '${HANDLER}' is not yet implemented" >&2
	exit 1
	;;
esac
wait

if [[ "$CANARY" -eq 1 ]] && [[ "$HANDLER" == "audio" ]]; then
	HANDLER_RECORD="$CANARY_RECORD"
	CANDIDATE_PATH="${RUN_OUTPUT}/.ai/canary-candidates/${UUID}/$(basename "$CANARY_RECORD")"
else
	HANDLER_RECORD="$(PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
		python3 "${SCRIPT_DIR}/shared/ingest_result.py" written \
		--ingests-dir "$RUN_OUTPUT" --log-path "$HANDLER_LOG")"
fi

if [[ "$CANARY" -eq 1 ]]; then
	if [[ -z "$HANDLER_RECORD" ]]; then
		echo "Error: canary handler did not report one written record" >&2
		exit 1
	fi
	PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
		python3 "${SCRIPT_DIR}/shared/canary_guard.py" \
		--ingests-dir "$INGESTS_DIR" \
		--parent "$INGESTS_BASE_HEAD" \
		--record-path "$HANDLER_RECORD" \
		--candidate-path "$CANDIDATE_PATH"
	echo "Canary candidate isolated for acceptance: ${CANDIDATE_PATH}" >&2
	exit 0
fi

echo "Done. Staging: ${RUN_DIR}" >&2

# Archive original source file and any sibling snapshots for workbench access
# Product components now live one level below the control-plane root that owns
# the off-Git archive. Keep the sibling fallback for standalone/test layouts.
CONTROL_RECORDS_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)/records"
if [[ -d "${SCRIPT_DIR}/../anomalica-common" ]]; then
	RECORDS_DIR="$CONTROL_RECORDS_DIR"
else
	RECORDS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)/records"
fi
mkdir -p "$RECORDS_DIR"
if [[ ! -f "$ASSET_PATH" ]]; then
	# A record with no archived original cannot be served for review, and this
	# must never pass silently: a month-old record with no source on disk was
	# found by a corpus audit, not by a log, because this step skipped wordlessly.
	echo "Error: no asset at ${ASSET_PATH} - ingest is partial and has no archived original" >&2
	exit 1
else
	CURRENT_ASSET_HASH="$(sha256sum "$ASSET_PATH" | cut -d' ' -f1)"
	if [[ "$CURRENT_ASSET_HASH" != "$ASSET_HASH" ]]; then
		echo "Error: staged Asset bytes changed while the handler ran" >&2
		exit 1
	fi
	ASSET_EXT="${ASSET##*.}"
	ASSET_EXT="${ASSET_EXT,,}"
	TARGET="${RECORDS_DIR}/${ASSET_HASH}.${ASSET_EXT}"
	ARCHIVE_RESULT="$(python3 "${SCRIPT_DIR}/shared/archive.py" \
		--source "$ASSET_PATH" --target "$TARGET" --expected-hash "$ASSET_HASH")"
	if [[ "$ARCHIVE_RESULT" == "created" ]]; then
		echo "Source archived: ${TARGET}" >&2
	fi
fi

# Resolve the handler's exact intermediate output. The record/3 finaliser below
# changes its path to canonical Selection identity; ambiguity here is a hard error.
if [[ -n "$HANDLER_RECORD" ]]; then
	RECORD_PATH="$HANDLER_RECORD"
else
	RECORD_PATH="$(PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
		python3 "${SCRIPT_DIR}/shared/ingest_result.py" resolve \
		--ingests-dir "$RUN_OUTPUT" \
		--asset-hash "$ASSET_HASH" \
		--source-id "$SOURCE_ID")"
fi

# Archive any sibling snapshots (e.g. PDF render of an HTML page) declared
# in the manifest's snapshots[] list. Each is content-addressed by sha256
# of its own bytes so workbench can resolve via {source_hash} -> sibling.
SNAPSHOT_PATHS="$(python3 -c "
import json
m = json.load(open('${MANIFEST}'))
for s in m.get('snapshots', []):
    print(s['path'], s.get('extension', 'bin'))
" 2>/dev/null || true)"
if [[ -n "$SNAPSHOT_PATHS" ]]; then
	while IFS=' ' read -r SNAP_NAME SNAP_EXT; do
		[[ -z "$SNAP_NAME" ]] && continue
		SNAP_PATH="${RUN_DIR}/${SNAP_NAME}"
		[[ ! -f "$SNAP_PATH" ]] && continue
		SNAP_HASH="$(sha256sum "$SNAP_PATH" | cut -d' ' -f1)"
		SNAP_EXT="${SNAP_EXT,,}"
		SNAP_TARGET="${RECORDS_DIR}/${SNAP_HASH}.${SNAP_EXT}"
		ARCHIVE_RESULT="$(python3 "${SCRIPT_DIR}/shared/archive.py" \
			--source "$SNAP_PATH" --target "$SNAP_TARGET" --expected-hash "$SNAP_HASH")"
		if [[ "$ARCHIVE_RESULT" == "created" ]]; then
			echo "Snapshot archived: ${SNAP_TARGET}" >&2
		fi
	done <<<"$SNAPSHOT_PATHS"
fi

# Handlers preserve their format-specific extraction and currently render a
# legacy-shaped intermediate. Finalise it once, from the exact staged bytes, into
# the shared Asset/Selection contract. PDF/image output also emits its immutable
# preparation-version-9 source map; failure to establish exact page mapping blocks
# publication rather than silently downgrading the Record.
RECORD_PATH="$(PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
	python3 "${SCRIPT_DIR}/shared/record3.py" finalise \
	--record "${RUN_OUTPUT}/${RECORD_PATH}" \
	--asset "$ASSET_PATH" \
	--manifest "$MANIFEST" \
	--output-dir "$RUN_OUTPUT")"
echo "Finalised record/3: ${RECORD_PATH}" >&2

if [[ -n "$RECORD_METADATA_FILE" ]]; then
	PYTHONPATH="${SCRIPT_DIR}/../anomalica-common/src:${PYTHONPATH:-}" \
		python3 "${SCRIPT_DIR}/shared/record_metadata.py" record \
		--record "${RUN_OUTPUT}/${RECORD_PATH}" \
		--by-name-dir "${RUN_OUTPUT}/by-name" \
		--metadata-file "$RECORD_METADATA_FILE"
fi

# The canonical nested Asset rights are authoritative after metadata merging.
# Rebuild the possession gate at Selection identity, or remove a stale gate when
# the final rights permit open serving; legacy handler sidecars are not authority.
python3 "${SCRIPT_DIR}/shared/verification.py" \
	--record "${RUN_OUTPUT}/${RECORD_PATH}" --source "$ASSET_PATH" >/dev/null

# Stamp source-quality labels onto the records produced this run. Host-side
# because the substitution detector's wordlist lives here, not in the format
# containers - so the score matches the corpus backfill. Idempotent: it re-derives
# the quality: block from the body and changes no hash (frontmatter is unhashed).
QUALITY_TARGETS="$({
	git -C "$RUN_OUTPUT" diff --name-only -- store/
	git -C "$RUN_OUTPUT" ls-files --others --exclude-standard -- store/
} 2>/dev/null | { grep -E '^store/[^/]+\.md$' || true; } | sort -u)"
if [[ -n "$QUALITY_TARGETS" ]]; then
	while IFS= read -r REC; do
		[[ -z "$REC" ]] && continue
		python3 "${SCRIPT_DIR}/shared/quality.py" stamp "${RUN_OUTPUT}/${REC}" 2>/dev/null || true
	done <<<"$QUALITY_TARGETS"
fi

# Back up every retained Asset to the Bunny storage zones (the push-at-archive
# contract). A sibling of the local archive step above, NOT a gate: non-fatal by
# design - `shared/audit_sources.py --bunny` catches and retries a failure, and the
# local archive stays the source of truth. Singular records retain the legacy
# storage pointer; composite and snapshot-bearing records have one independently
# addressed object per Asset. Routes open/gated by each Asset's copyright.status;
# audio and video are backed up too (a re-fetch cannot reproduce exact bytes).
if [[ -n "$QUALITY_TARGETS" ]]; then
	while IFS= read -r REC; do
		[[ -z "$REC" ]] && continue
		# Non-fatal but NEVER silent: a push must not fail the ingest, but a wrong
		# credential, an expired key or a network blip must not read as a successful
		# no-op either - that indistinguishability is the exact failure that lost a
		# third of the corpus. Surface the result; shout on a real failure.
		PUSH_RESULT="$(python3 "${SCRIPT_DIR}/shared/bunny_storage.py" "${RUN_OUTPUT}/${REC}" 2>&1 || true)"
		echo "  backup: ${PUSH_RESULT}" >&2
		case "$PUSH_RESULT" in
		no-cred* | failed* | "")
			echo "  WARNING: source NOT backed up to Bunny (${PUSH_RESULT:-error}) - fix and re-run shared/audit_sources.py --bunny" >&2
			;;
		esac
	done <<<"$QUALITY_TARGETS"
fi

# Build one patch containing only this run's repository outputs. Intent-to-add
# makes untracked output visible to `git diff` without changing the live index.
git -C "$RUN_OUTPUT" add -N -- store/ by-name/ media/
OUTPUT_PATHS=(store/ by-name/ media/)
if [[ -d "${RUN_OUTPUT}/source-maps" ]]; then
	git -C "$RUN_OUTPUT" add -N -- source-maps/
	OUTPUT_PATHS+=(source-maps/)
fi
PATCH_PATH="${RUN_DIR}/output.patch"
git -C "$RUN_OUTPUT" diff --binary HEAD -- "${OUTPUT_PATHS[@]}" >"$PATCH_PATH"
mapfile -d '' CHANGED_PATHS < <(git -C "$RUN_OUTPUT" diff --name-only -z HEAD -- "${OUTPUT_PATHS[@]}")

# Guard the resolved Record even when finalisation produced byte-identical output.
# Otherwise a concurrent review can replace that path after extraction, leave no
# local patch to trigger the loop below, and then be misreported as this run's
# successful commit.
GUARD_PATHS=("${CHANGED_PATHS[@]}" "$RECORD_PATH")

# The shared lock covers only publication. Each path must still equal the base
# snapshot in both HEAD and the live worktree; otherwise a concurrent review or
# housekeeping change wins and this run fails without overwriting it.
acquire_ingests_write_lock
for path in "${GUARD_PATHS[@]}"; do
	if ! git -C "$INGESTS_DIR" diff --quiet "$INGESTS_BASE_HEAD" HEAD -- "$path" ||
		! git -C "$INGESTS_DIR" diff --quiet HEAD -- "$path" ||
		{ ! git -C "$INGESTS_DIR" cat-file -e "HEAD:${path}" 2>/dev/null && [[ -e "${INGESTS_DIR}/${path}" || -L "${INGESTS_DIR}/${path}" ]]; }; then
		echo "Error: concurrent change to ${path}; isolated ingest output preserved at ${RUN_OUTPUT}" >&2
		exit 1
	fi
done

if [[ -s "$PATCH_PATH" ]]; then
	git -C "$INGESTS_DIR" apply "$PATCH_PATH"
fi

# Auto-commit this run's paths (unless --no-commit, used for bulk corpus runs
# that intentionally leave outputs in the shared worktree for one later commit).
if [[ "$NO_COMMIT" -eq 1 ]]; then
	echo "Skipping auto-commit (--no-commit). Records left for manual commit." >&2
	release_ingests_write_lock
	git -C "$INGESTS_DIR" worktree remove --force "$RUN_OUTPUT"
	exit 0
fi
cd "$INGESTS_DIR"
RUN_COMMITTED=0
if [[ "${#CHANGED_PATHS[@]}" -gt 0 ]]; then
	echo "" >&2
	echo "Committing new records to ingests..." >&2
	git add -- "${CHANGED_PATHS[@]}"
	NEW_FILES="$(git -C "$RUN_OUTPUT" diff --name-only --diff-filter=A HEAD -- store/ | grep -c '^store/' || true)"
	if [[ "$NEW_FILES" -gt 0 ]]; then
		COMMIT_MSG="ingest: add ${NEW_FILES} record(s) from ${HANDLER} ingestion"
	else
		COMMIT_MSG="ingest: update records from ${HANDLER} ingestion"
	fi
	GIT_AUTHOR_NAME="Anomalica Ingester" \
		GIT_AUTHOR_EMAIL="ingester@anomalica.is" \
		GIT_COMMITTER_NAME="Anomalica Ingester" \
		GIT_COMMITTER_EMAIL="ingester@anomalica.is" \
		git commit --only -m "$COMMIT_MSG" -- "${CHANGED_PATHS[@]}" >&2
	RUN_COMMITTED=1
	echo "Committed. Run 'git push' from ${INGESTS_DIR} to publish." >&2
else
	echo "No new records to commit." >&2
fi

INGESTS_HEAD_AFTER="$(git rev-parse HEAD)"
OUTCOME="no-op"
if [[ "$RUN_COMMITTED" -eq 1 ]]; then
	OUTCOME="committed"
fi
emit_result "$OUTCOME" "$RECORD_PATH" "$INGESTS_HEAD_AFTER"
release_ingests_write_lock
git -C "$INGESTS_DIR" worktree remove --force "$RUN_OUTPUT"
