#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STAGING_DIR="${SCRIPT_DIR}/staging"
INGESTS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)/ingests"

usage() {
	echo "Usage: ingest [--force] [--source-url URL [--source-id ID]] <url-or-path>" >&2
	echo "" >&2
	echo "Acquire a URL or local file and route to the appropriate format handler." >&2
	echo "" >&2
	echo "Options:" >&2
	echo "  --force        Re-process even if output already exists" >&2
	echo "  --source-url   Provenance for a LOCAL source: stamp this origin URL" >&2
	echo "                 (a local path carries none). Use when re-processing an" >&2
	echo "                 archived file, e.g. re-transcribing an .opus as record/2" >&2
	echo "  --source-id    Optional stable id for --source-url; derived from the URL" >&2
	echo "                 when omitted (youtube:{id} / url:{hash})" >&2
	exit 1
}

FORCE=""
FORCE_FLAG=0
INPUT=""
COPYRIGHT_STATUS=""
NO_COMMIT=0
USE_API=0
SOURCE_URL=""
SOURCE_ID=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	--force)
		FORCE="--force"
		FORCE_FLAG=1
		shift
		;;
	--copyright)
		COPYRIGHT_STATUS="$2"
		shift 2
		;;
	--copyright=*)
		COPYRIGHT_STATUS="${1#*=}"
		shift
		;;
	--no-commit)
		NO_COMMIT=1
		shift
		;;
	--api)
		USE_API=1
		shift
		;;
	--source-url)
		SOURCE_URL="$2"
		shift 2
		;;
	--source-url=*)
		SOURCE_URL="${1#*=}"
		shift
		;;
	--source-id)
		SOURCE_ID="$2"
		shift 2
		;;
	--source-id=*)
		SOURCE_ID="${1#*=}"
		shift
		;;
	--help | -h) usage ;;
	-*)
		echo "Unknown option: $1" >&2
		usage
		;;
	*)
		if [[ -n "$INPUT" ]]; then
			echo "Error: multiple inputs not supported" >&2
			usage
		fi
		INPUT="$1"
		shift
		;;
	esac
done

if [[ -z "$INPUT" ]]; then
	usage
fi

if [[ ! -d "$INGESTS_DIR" ]]; then
	echo "Error: ingests not found at ${INGESTS_DIR}" >&2
	echo "Clone it with: gh repo clone anomalica/ingests $(dirname "${INGESTS_DIR}")" >&2
	exit 1
fi

# Capture the ingester version (git short hash) and write it to .env so the
# format containers (which don't have .git/) can read it via the auto-loaded
# .env file. This makes the version field of each record reproducible.
INGESTER_VERSION="$(cd "$SCRIPT_DIR" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
ENV_FILE="${SCRIPT_DIR}/.env"
touch "$ENV_FILE"
if grep -q "^INGESTER_VERSION=" "$ENV_FILE"; then
	sed -i "s|^INGESTER_VERSION=.*|INGESTER_VERSION=${INGESTER_VERSION}|" "$ENV_FILE"
else
	echo "INGESTER_VERSION=${INGESTER_VERSION}" >>"$ENV_FILE"
fi

# Provider selection for the PDF handler: metered Anthropic API only when
# --api is passed; otherwise the flat-rate Claude Code session. Written to
# .env (auto-loaded by the format containers) every run so it always
# reflects this invocation rather than a stale value.
if grep -q "^INGEST_USE_API=" "$ENV_FILE"; then
	sed -i "s|^INGEST_USE_API=.*|INGEST_USE_API=${USE_API}|" "$ENV_FILE"
else
	echo "INGEST_USE_API=${USE_API}" >>"$ENV_FILE"
fi

is_url() {
	[[ "$1" =~ ^https?:// ]]
}

# For local files, pre-hash and check if already in the ingests repo
if ! is_url "$INPUT"; then
	if [[ ! -f "$INPUT" ]]; then
		echo "Error: file not found: ${INPUT}" >&2
		exit 1
	fi
	FILE_HASH="$(sha256sum "$INPUT" | cut -d' ' -f1)"
	if { [[ -f "${INGESTS_DIR}/store/${FILE_HASH}.md" ]] || [[ -f "${INGESTS_DIR}/store/${FILE_HASH}.v2.md" ]]; } && [[ "$FORCE_FLAG" -eq 0 ]]; then
		echo "Skipping: already ingested (hash: ${FILE_HASH:0:12}...)" >&2
		exit 0
	fi
fi

# For URLs, pre-fetch dedup by exact source_url match
if is_url "$INPUT" && [[ "$FORCE_FLAG" -eq 0 ]]; then
	EXISTING="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_url
match = find_by_source_url(Path('${INGESTS_DIR}/store'), '${INPUT}')
print(match if match else '')
")"
	if [[ -n "$EXISTING" ]]; then
		echo "Skipping: URL already ingested" >&2
		echo "Existing record: ${EXISTING}" >&2
		exit 0
	fi
fi

UUID="$(python3 -c 'import uuid; print(uuid.uuid4())')"
RUN_DIR="${STAGING_DIR}/${UUID}"
mkdir -p "$RUN_DIR"

echo "Run: ${UUID}" >&2

if is_url "$INPUT"; then
	echo "Acquiring: ${INPUT}" >&2
	(cd "${SCRIPT_DIR}/acquire" && cm run acquire "$INPUT" -- --staging-dir "/mnt/staging/${UUID}")
else
	RESOLVED="$(realpath "$INPUT")"
	EXT="${RESOLVED##*.}"
	cp "$RESOLVED" "${RUN_DIR}/asset.${EXT}"

	DETECTED_TYPE="$(SCRIPT_DIR="${SCRIPT_DIR}" ASSET_FILE="${RUN_DIR}/asset.${EXT}" python3 -c "
import os, sys
sys.path.insert(0, os.path.join(os.environ['SCRIPT_DIR'], 'acquire/workspace'))
from detect import detect_from_bytes, detect_from_extension
asset_file = os.environ['ASSET_FILE']
with open(asset_file, 'rb') as f:
    data = f.read(8192)
result = detect_from_bytes(data)
if not result:
    result = detect_from_extension(asset_file)
print(result or 'application/octet-stream')
")"

	SOURCE_PATH="${RESOLVED}" ASSET_NAME="asset.${EXT}" DETECTED_TYPE="${DETECTED_TYPE}" \
		MANIFEST_OUT="${RUN_DIR}/manifest.json" COPYRIGHT_STATUS="${COPYRIGHT_STATUS}" \
		SOURCE_URL="${SOURCE_URL}" SOURCE_ID="${SOURCE_ID}" SCRIPT_DIR="${SCRIPT_DIR}" python3 -c "
import hashlib, json, os, re, subprocess, sys
from datetime import datetime, timezone
sys.path.insert(0, os.path.join(os.environ['SCRIPT_DIR'], 'acquire/workspace'))
from manifest_meta import video_metadata_fields
manifest = {
    'source': os.environ['SOURCE_PATH'],
    'asset': os.environ['ASSET_NAME'],
    'detected_type': os.environ['DETECTED_TYPE'],
    'fetch_method': 'local',
    'fetched_at': datetime.now(timezone.utc).isoformat(),
}
copyright_status = os.environ.get('COPYRIGHT_STATUS', '')
if copyright_status:
    manifest['copyright_status'] = copyright_status
# Known provenance for re-processing an archived local source (e.g. re-transcribing
# an archived .opus as record/2): a local path carries no origin, so stamp the
# supplied source URL and a stable source_id (derived to match the URL path's
# convention when not given explicitly).
source_url = os.environ.get('SOURCE_URL', '')
source_id = os.environ.get('SOURCE_ID', '')
if source_url:
    manifest['source_url'] = source_url
    if not source_id:
        m = re.search(r'(?:youtube\.com/watch\?v=|youtu\.be/|youtube\.com/embed/|youtube\.com/shorts/)([A-Za-z0-9_-]{11})', source_url)
        source_id = f'youtube:{m.group(1)}' if m else 'url:' + hashlib.sha256(source_url.encode('utf-8')).hexdigest()[:12]
    # Re-fetch the source's real metadata so a re-processed local archive keeps its
    # title/publisher/date instead of falling back to the raw URL (which is what the
    # record showed until this landed). yt-dlp --dump-json is METADATA ONLY - no
    # download - so it's cheap and doesn't trigger the download bot-check. The field
    # mapping (video_metadata_fields) is SHARED with acquire's URL path, so a
    # reprocess record is indistinguishable from a fresh URL ingest. Best effort: a
    # fetch failure leaves the URL-only manifest rather than aborting re-transcription.
    try:
        proc = subprocess.run(['yt-dlp', '--dump-json', '--no-warnings', source_url],
                              capture_output=True, text=True, timeout=90)
        if proc.returncode == 0 and proc.stdout.strip():
            fields = video_metadata_fields(json.loads(proc.stdout))
            fields.pop('source_id', None)  # keep the explicit/URL-derived id below
            manifest.update(fields)
    except (subprocess.SubprocessError, OSError, ValueError):
        pass
if source_id:
    manifest['source_id'] = source_id
with open(os.environ['MANIFEST_OUT'], 'w') as f:
    json.dump(manifest, f, indent=2)
"
	echo "Local file staged: ${DETECTED_TYPE}" >&2
fi

MANIFEST="${RUN_DIR}/manifest.json"
if [[ ! -f "$MANIFEST" ]]; then
	echo "Error: no manifest found after acquisition" >&2
	exit 1
fi

DETECTED_TYPE="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('detected_type') or '')")"
ASSET="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('asset') or '')")"
SOURCE_ID="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('source_id') or '')")"

if [[ -z "$DETECTED_TYPE" || -z "$ASSET" ]]; then
	ERROR="$(python3 -c "import json; m=json.load(open('${MANIFEST}')); print(m.get('error', 'unknown error'))")"
	echo "Error: acquisition failed - ${ERROR}" >&2
	exit 1
fi

# Post-acquire dedup by source_id (e.g. youtube:ZBtMbBPzqHY). Catches the
# case where the same video re-downloaded with a fresh container has a new
# byte hash but is logically the same source.
if [[ -n "$SOURCE_ID" ]] && [[ "$FORCE_FLAG" -eq 0 ]]; then
	EXISTING="$(PYTHONPATH="${SCRIPT_DIR}/shared" python3 -c "
from pathlib import Path
from dedup import find_by_source_id
match = find_by_source_id(Path('${INGESTS_DIR}/store'), '${SOURCE_ID}')
print(match if match else '')
")"
	if [[ -n "$EXISTING" ]]; then
		echo "Skipping: source_id already ingested (${SOURCE_ID})" >&2
		echo "Existing record: ${EXISTING}" >&2
		exit 0
	fi
fi

echo "Detected type: ${DETECTED_TYPE}" >&2

HANDLER=""
for format_yaml in "${SCRIPT_DIR}"/formats/*/format.yaml; do
	FORMAT_DIR="$(dirname "$format_yaml")"
	FORMAT_NAME="$(basename "$FORMAT_DIR")"

	if python3 -c "
import yaml, sys
with open('${format_yaml}') as f:
    fmt = yaml.safe_load(f)
sys.exit(0 if '${DETECTED_TYPE}' in fmt.get('handles', []) else 1)
"; then
		HANDLER="$FORMAT_NAME"
		break
	fi
done

if [[ -z "$HANDLER" ]]; then
	echo "Error: no format handler for type: ${DETECTED_TYPE}" >&2
	echo "Staging directory preserved: ${RUN_DIR}" >&2
	exit 1
fi

echo "Routing to: ${HANDLER}" >&2

case "$HANDLER" in
webpage)
	(cd "${SCRIPT_DIR}/formats/webpage" && cm run ingest "/mnt/staging/${UUID}" -- $FORCE)
	;;
pdf)
	(cd "${SCRIPT_DIR}/formats/pdf" && cm run ingest -- --staging-dir "/mnt/staging/${UUID}" $FORCE)
	;;
audio)
	(cd "${SCRIPT_DIR}/formats/audio" && cm run ingest "/mnt/staging/${UUID}" -- $FORCE)
	;;
ebook)
	(cd "${SCRIPT_DIR}/formats/ebook" && cm run ingest "/mnt/staging/${UUID}" -- $FORCE)
	;;
*)
	echo "Error: handler '${HANDLER}' is not yet implemented" >&2
	exit 1
	;;
esac

echo "Done. Staging: ${RUN_DIR}" >&2

# Archive original source file and any sibling snapshots for workbench access
RECORDS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)/records"
mkdir -p "$RECORDS_DIR"
ASSET_PATH="${RUN_DIR}/${ASSET}"
if [[ ! -f "$ASSET_PATH" ]]; then
	# A record with no archived original cannot be served for review, and this
	# must never pass silently: a month-old record with no source on disk was
	# found by a corpus audit, not by a log, because this step skipped wordlessly.
	echo "WARNING: no asset at ${ASSET_PATH} - record has NO archived original" >&2
else
	CONTENT_HASH="$(sha256sum "$ASSET_PATH" | cut -d' ' -f1)"
	ASSET_EXT="${ASSET##*.}"
	TARGET="${RECORDS_DIR}/${CONTENT_HASH}.${ASSET_EXT}"
	if [[ ! -f "$TARGET" ]]; then
		cp "$ASSET_PATH" "$TARGET"
		echo "Source archived: ${TARGET}" >&2
	fi

	# Stamp the archived object's extension onto the record - the archive and this
	# stamp are ONE statement: an archived file whose record lacks archived_ext
	# cannot be addressed and reads as sourceless (the codec/container describe the
	# STREAM; the extension is a property of the FILE - yt-dlp writes .opus while
	# reporting container: ogg - so consumers must not guess). Parse the whole
	# frontmatter, never a fixed-size window (source_hash falls past a long ebook
	# blurb), and be LOUD when nothing matches so a miss surfaces here, not months
	# later in an audit.
	INGESTS_DIR="${INGESTS_DIR}" CONTENT_HASH="${CONTENT_HASH}" ASSET_EXT="${ASSET_EXT}" python3 -c "
import os, re, sys
from pathlib import Path
store = Path(os.environ['INGESTS_DIR']) / 'store'
h, ext = os.environ['CONTENT_HASH'], os.environ['ASSET_EXT']


def frontmatter(p):
    t = p.read_text(errors='replace')
    m = re.match(r'^(---\n)(.*?)(\n---\n)', t, re.S)
    return t, m


# audio/video/pdf: record is named by the asset hash. web/ebook: the record is
# body-hashed and the asset hash is its source_hash - found by parsing each
# record's frontmatter, never by windowing the file.
cands = [store / f'{h}.v2.md', store / f'{h}.md']
for p in store.glob('*.md'):
    _, m = frontmatter(p)
    if m and f'source_hash: sha256:{h}' in m.group(2):
        cands.append(p)
for p in cands:
    if not p.exists():
        continue
    t, m = frontmatter(p)
    if not m:
        continue
    fmv = m.group(2)
    if re.search(r'^archived_ext:', fmv, re.M):
        fmv = re.sub(r'^archived_ext:.*$', f'archived_ext: {ext}', fmv, flags=re.M)
    elif re.search(r'^content_hash:.*$', fmv, re.M):
        fmv = re.sub(r'^(content_hash:.*)$', r'\1' + f'\narchived_ext: {ext}', fmv, count=1, flags=re.M)
    else:
        fmv = fmv + f'\narchived_ext: {ext}'
    p.write_text(m.group(1) + fmv + m.group(3) + t[m.end():])
    print(f'Stamped archived_ext: {ext} -> {p.name}', file=sys.stderr)
    break
else:
    print(f'WARNING: archived {h[:12]}.{ext} but found NO record to stamp archived_ext on', file=sys.stderr)
" || echo "WARNING: archived_ext stamp step errored for ${CONTENT_HASH:0:12}" >&2
fi

# Archive any sibling snapshots (e.g. PDF render of an HTML page) declared
# in the manifest's snapshots[] list. Each is content-addressed by sha256
# of its own bytes so workbench can resolve via {source_hash} -> sibling.
SNAPSHOT_PATHS="$(python3 -c "
import json
m = json.load(open('${MANIFEST}'))
for s in m.get('snapshots', []):
    print(s['path'], s.get('extension', 'bin'))
" 2>/dev/null || true)"
if [[ -n "$SNAPSHOT_PATHS" ]]; then
	while IFS=' ' read -r SNAP_NAME SNAP_EXT; do
		[[ -z "$SNAP_NAME" ]] && continue
		SNAP_PATH="${RUN_DIR}/${SNAP_NAME}"
		[[ ! -f "$SNAP_PATH" ]] && continue
		SNAP_HASH="$(sha256sum "$SNAP_PATH" | cut -d' ' -f1)"
		SNAP_TARGET="${RECORDS_DIR}/${SNAP_HASH}.${SNAP_EXT}"
		if [[ ! -f "$SNAP_TARGET" ]]; then
			cp "$SNAP_PATH" "$SNAP_TARGET"
			echo "Snapshot archived: ${SNAP_TARGET}" >&2
		fi
	done <<<"$SNAPSHOT_PATHS"
fi

# Stamp source-quality labels onto the records produced this run. Host-side
# because the substitution detector's wordlist lives here, not in the format
# containers - so the score matches the corpus backfill. Idempotent: it re-derives
# the quality: block from the body and changes no hash (frontmatter is unhashed).
QUALITY_TARGETS="$({
	git -C "$INGESTS_DIR" diff --name-only -- store/
	git -C "$INGESTS_DIR" ls-files --others --exclude-standard -- store/
} 2>/dev/null | grep -E '^store/[^/]+\.md$' | sort -u)"
if [[ -n "$QUALITY_TARGETS" ]]; then
	while IFS= read -r REC; do
		[[ -z "$REC" ]] && continue
		python3 "${SCRIPT_DIR}/shared/quality.py" stamp "${INGESTS_DIR}/${REC}" 2>/dev/null || true
	done <<<"$QUALITY_TARGETS"
fi

# Auto-commit any new records to ingests (unless --no-commit,
# used for bulk corpus runs that want a single bundled commit at the end)
if [[ "$NO_COMMIT" -eq 1 ]]; then
	echo "Skipping auto-commit (--no-commit). Records left staged for manual commit." >&2
	exit 0
fi
cd "$INGESTS_DIR"
if [[ -n "$(git status --porcelain)" ]]; then
	echo "" >&2
	echo "Committing new records to ingests..." >&2
	# by-name/, not records/: the rename landed and this staging line did not,
	# so every ingest extracted fine and then died at the commit with
	# "pathspec 'records/' did not match any files", leaving the record uncommitted.
	git add store/ by-name/ media/
	NEW_FILES="$(git diff --cached --name-only --diff-filter=A | grep '^store/' | wc -l)"
	if [[ "$NEW_FILES" -gt 0 ]]; then
		COMMIT_MSG="ingest: add ${NEW_FILES} record(s) from ${HANDLER} ingestion"
	else
		COMMIT_MSG="ingest: update records from ${HANDLER} ingestion"
	fi
	GIT_AUTHOR_NAME="Anomalica Ingester" \
		GIT_AUTHOR_EMAIL="ingester@anomalica.is" \
		GIT_COMMITTER_NAME="Anomalica Ingester" \
		GIT_COMMITTER_EMAIL="ingester@anomalica.is" \
		git commit -m "$COMMIT_MSG" >&2
	echo "Committed. Run 'git push' from ${INGESTS_DIR} to publish." >&2
else
	echo "No new records to commit." >&2
fi
